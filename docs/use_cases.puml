        usecase "UC-006\nUpdate Owner" as UC006 <<Done>> [[use_cases/UC-006-update-owner.md]]
    }

    package "Pet Management" {
        usecase "UC-007\nAdd Pet to Owner" as UC007 <<Done>> [[use_cases/UC-007-add-pet-to-owner.md]]
